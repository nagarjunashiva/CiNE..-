# CiNE Server Configuration
PORT=5000

# MongoDB Connection String (e.g. mongodb://127.0.0.1:27017/cine or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/cine

# JWT Secret
JWT_SECRET=cine_super_secret_jwt_key_2026_cinematic_auth

# SMTP Relay Configuration (Brevo / Sendinblue or Gmail)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login
SMTP_PASS=your_smtp_password

# Official Sender Identity
EMAIL_FROM="CiNE Entertainment" <verify@cine.app>
REPLY_TO=support@cine.app
